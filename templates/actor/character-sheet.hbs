<div class="omens13 character-sheet">

  <div class="logo-banner">
    <img src="systems/omens13/assets/branding/logo-wordmark.png" alt="13 Omens" />
    <nav class="sheet-tabs">
      <a data-action="switchTab" data-tab="stats" class="{{#if (eq activeTab 'stats')}}active{{/if}}">{{localize "OMENS13.Sheet.TabStats"}}</a>
      <a data-action="switchTab" data-tab="notes" class="{{#if (eq activeTab 'notes')}}active{{/if}}">{{localize "OMENS13.Sheet.TabNotes"}}</a>
    </nav>
  </div>

  <header class="sheet-header">
    <img class="portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" />
    <div class="header-fields">
      <div class="name-traits-row">
        <div class="name-traits-col">
          <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'OMENS13.Sheet.Name'}}" class="name-input" />
          <input type="text" name="system.traits" value="{{system.traits}}" placeholder="{{localize 'OMENS13.Sheet.Traits'}}" class="traits-input" />
        </div>
        <div class="wounds-summary" title="{{localize 'OMENS13.Sheet.WoundsHint'}}">
          <img class="death-icon" src="systems/omens13/assets/branding/death-icon.png" alt="" />
          <span class="label">{{localize "OMENS13.Sheet.Wounds"}}</span>
          <span class="value {{#if system.wounds.hasPermanentFlaw}}danger{{/if}}">{{system.wounds.value}} / {{system.wounds.deathThreshold}}</span>
        </div>
      </div>
      <div class="goal-field">
        <span class="goal-label">{{localize "OMENS13.Sheet.Goal"}}</span>
        <prose-mirror class="content-sized" name="system.goal" value="{{system.goal}}" toggled>{{{enriched.goal}}}</prose-mirror>
      </div>
    </div>
  </header>

  <div class="tab-panel {{#if (eq activeTab 'stats')}}active{{/if}}" data-tab-panel="stats">

    <section class="aspects two-columns">
      <div class="aspect-block core">
        <h2>
          {{localize "OMENS13.Sheet.CoreAspects"}}
          <button type="button" class="edit-button spacer" tabindex="-1" aria-hidden="true"><i class="fa-solid fa-pen"></i></button>
        </h2>
        <table class="aspect-table">
          <thead>
            <tr>
              <th class="col-label">{{localize "OMENS13.Sheet.Aspect"}}</th>
              <th class="col-rating">{{localize "OMENS13.Sheet.Rating"}}</th>
              <th class="col-tn">{{localize "OMENS13.Sheet.TN"}}</th>
              <th class="col-strain">{{localize "OMENS13.Sheet.Strain"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each coreAspects as |aspect|}}
            <tr class="aspect-row {{#if aspect.tn}}rollable{{/if}} {{#if aspect.strain}}strained{{/if}}" data-group="{{aspect.group}}" data-key="{{aspect.key}}" title="{{localize 'OMENS13.Sheet.Check'}}">
              <td class="col-label">{{aspect.label}}</td>
              <td class="col-rating">
                <select name="system.{{aspect.group}}.{{aspect.key}}.rating">
                  {{#each ../ratings as |r|}}
                  <option value="{{r.value}}" {{#if (eq r.value aspect.rating)}}selected{{/if}}>{{r.label}}</option>
                  {{/each}}
                </select>
              </td>
              <td class="col-tn">{{#if aspect.tn}}{{aspect.tn}}{{else}}—{{/if}}</td>
              <td class="col-strain"><input type="checkbox" class="aspect-strain-toggle" name="system.{{aspect.group}}.{{aspect.key}}.strain" {{checked aspect.strain}} /></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class="aspect-block story">
        <h2>
          {{localize "OMENS13.Sheet.StoryAspects"}}
          <button type="button" class="edit-button" data-action="editStoryAspects" title="{{localize 'OMENS13.Sheet.EditStoryAspects'}}"><i class="fa-solid fa-pen"></i></button>
        </h2>
        <table class="aspect-table">
          <thead>
            <tr>
              <th class="col-label">{{localize "OMENS13.Sheet.Aspect"}}</th>
              <th class="col-rating">{{localize "OMENS13.Sheet.Rating"}}</th>
              <th class="col-tn">{{localize "OMENS13.Sheet.TN"}}</th>
              <th class="col-strain">{{localize "OMENS13.Sheet.Strain"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each storyAspects as |aspect|}}
            <tr class="aspect-row {{#if aspect.tn}}rollable{{/if}} {{#if aspect.strain}}strained{{/if}}" data-group="{{aspect.group}}" data-key="{{aspect.key}}" title="{{localize 'OMENS13.Sheet.Check'}}">
              <td class="col-label">
                {{#if aspect.label}}{{aspect.label}}{{else}}<span class="empty-hint">{{localize "OMENS13.Sheet.UnnamedAspect"}}</span>{{/if}}
              </td>
              <td class="col-rating">
                <select name="system.{{aspect.group}}.{{aspect.key}}.rating">
                  {{#each ../ratings as |r|}}
                  <option value="{{r.value}}" {{#if (eq r.value aspect.rating)}}selected{{/if}}>{{r.label}}</option>
                  {{/each}}
                </select>
              </td>
              <td class="col-tn">{{#if aspect.tn}}{{aspect.tn}}{{else}}—{{/if}}</td>
              <td class="col-strain"><input type="checkbox" class="aspect-strain-toggle" name="system.{{aspect.group}}.{{aspect.key}}.strain" {{checked aspect.strain}} /></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>

    <section class="perks">
      <h2>
        {{localize "OMENS13.Sheet.Perks"}}
        <span class="section-buttons">
          {{#if hiddenPerkCount}}
          <button type="button" class="hidden-perks-filter {{#if showHiddenPerks}}active{{/if}}" data-action="toggleHiddenList" data-list="perks" title="{{#if showHiddenPerks}}{{localize 'OMENS13.Sheet.HideHiddenPerks'}}{{else}}{{localize 'OMENS13.Sheet.ShowHiddenPerks'}}{{/if}}">
            <i class="fa-solid {{#if showHiddenPerks}}fa-eye{{else}}fa-eye-slash{{/if}}"></i> {{hiddenPerkCount}}
          </button>
          {{/if}}
          <button type="button" class="add-button" data-action="addPerk"><i class="fa-solid fa-plus"></i></button>
        </span>
      </h2>
      <div class="perk-list {{#if showHiddenPerks}}show-hidden{{/if}}">
        {{#each perks as |perk|}}
        <div class="perk-item {{#if perk.expanded}}expanded{{/if}} {{#if perk.selected}}owned{{/if}} {{#if perk.strain}}strained{{/if}} {{#if perk.hidden}}hidden-perk{{/if}}" data-item-id="{{perk.id}}">
          <div class="perk-header">
            <input type="checkbox" class="perk-owned" data-field="system.selected" title="{{localize 'OMENS13.Sheet.PerkOwnedHint'}}" {{checked perk.selected}} />
            <span class="perk-title" data-action="sendPerkToChat" title="{{localize 'OMENS13.Sheet.SendToChat'}}">{{perk.name}}</span>
            <div class="perk-tools">
              <button type="button" class="perk-tool" data-action="editPerk" title="{{localize 'OMENS13.Sheet.EditPerk'}}"><i class="fa-solid fa-pen"></i></button>
              <button type="button" class="perk-tool danger" data-action="deletePerk" title="{{localize 'OMENS13.Sheet.DeletePerk'}}"><i class="fa-solid fa-trash"></i></button>
            </div>
            <input type="checkbox" class="perk-strain-toggle" data-field="system.strain" title="{{localize 'OMENS13.Sheet.PerkStrainHint'}}" {{checked perk.strain}} />
            <button type="button" class="perk-hide" data-action="togglePerkHidden" title="{{#if perk.hidden}}{{localize 'OMENS13.Sheet.PerkShow'}}{{else}}{{localize 'OMENS13.Sheet.PerkHide'}}{{/if}}">
              <i class="fa-solid {{#if perk.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
            </button>
            <button type="button" class="perk-toggle" data-action="togglePerk" title="{{localize 'OMENS13.Sheet.ToggleDescription'}}">
              <i class="fa-solid fa-chevron-down"></i>
            </button>
          </div>
          <div class="perk-body">
            <div class="perk-description">
              {{#if perk.enrichedDescription}}{{{perk.enrichedDescription}}}{{else}}<p class="empty-hint">{{localize "OMENS13.Sheet.PerkNoDescription"}}</p>{{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </section>

    <section class="gear">
      <h2>
        {{localize "OMENS13.Sheet.Gear"}}
        <span class="section-buttons">
          {{#if hiddenGearCount}}
          <button type="button" class="hidden-perks-filter {{#if showHiddenGear}}active{{/if}}" data-action="toggleHiddenList" data-list="gear" title="{{#if showHiddenGear}}{{localize 'OMENS13.Sheet.HideHiddenGear'}}{{else}}{{localize 'OMENS13.Sheet.ShowHiddenGear'}}{{/if}}">
            <i class="fa-solid {{#if showHiddenGear}}fa-eye{{else}}fa-eye-slash{{/if}}"></i> {{hiddenGearCount}}
          </button>
          {{/if}}
          <button type="button" class="add-button" data-action="addGear"><i class="fa-solid fa-plus"></i></button>
        </span>
      </h2>
      <div class="gear-tags {{#if showHiddenGear}}show-hidden{{/if}}">
        {{#each gear as |g|}}
        <span class="gear-tag {{#if g.broken}}broken{{/if}} {{#if g.hidden}}hidden-gear{{/if}}" data-action="useGear" data-index="{{g.index}}" title="{{#if g.broken}}{{localize 'OMENS13.Sheet.GearBrokenHint'}}{{else}}{{localize 'OMENS13.Sheet.GearTagHint'}}{{/if}}">
          {{#if g.broken}}<i class="fa-solid fa-heart-crack"></i>{{/if}}{{g.name}}
        </span>
        {{/each}}
        <input type="text" class="gear-new" placeholder="{{localize 'OMENS13.Sheet.GearAdd'}}" />
      </div>
    </section>

  </div>

  <div class="tab-panel {{#if (eq activeTab 'notes')}}active{{/if}}" data-tab-panel="notes">
    <section class="notes">
      <prose-mirror name="system.notes" value="{{system.notes}}" toggled>{{{enriched.notes}}}</prose-mirror>
    </section>
  </div>

</div>
